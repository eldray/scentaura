# Copy this file to ".env" and fill in your own values. NEVER share or upload the real .env file.

# --- Your domain, used by the HTTPS web server in docker-compose (no https://, no www) ---
DOMAIN=your-domain.com

# --- Basic ---
# development = on your own computer.  production = on the live server (Docker sets this for you).
NODE_ENV=development
PORT=3000
# The public address of your shop. On your computer: http://localhost:3000   Live: https://your-domain.com (must start with https://)
# Your public web address. Used in referral links, emails and Paystack return links.
# On your live server this MUST be your real address, e.g. https://www.yourshop.com (no trailing slash).
BASE_URL=http://localhost:3000

# A long random text. Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-value

# --- Where files are kept (use a persistent disk/volume on your host) ---
DATABASE_PATH=./data/scentaura.db
UPLOAD_DIR=./uploads

# --- Paystack (get keys from dashboard.paystack.com > Settings > API Keys) ---
# Use sk_test_... while testing, then sk_live_... when you go live.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# --- Email (optional but recommended). Any SMTP provider works. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ScentAura <orders@your-domain.com>"

# --- Only for creating the very first owner from the web page (optional) ---
# Prefer:  npm run create-admin   Remove this line after the owner exists.
ADMIN_SETUP_TOKEN=
