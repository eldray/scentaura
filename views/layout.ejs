<!doctype html>
<html lang="en-GH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const pageTitle = title ? (title.includes(S.business_name) ? title : title + ' | ' + S.business_name) : S.business_name; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= description || S.default_meta_description %>">
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:site_name" content="<%= S.business_name %>">
  <meta property="og:title" content="<%= title || S.business_name %>">
  <meta property="og:description" content="<%= description || S.default_meta_description %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <% const og = ogImage || (S.hero_image ? baseUrl + S.hero_image : null); if (og) { %><meta property="og:image" content="<%= og %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#111111">
  <% if (S.logo_path) { %><link rel="icon" href="<%= S.logo_path %>"><% } else { %><link rel="icon" href="/public/img/favicon.svg" type="image/svg+xml"><% } %>
  <link rel="stylesheet" href="/public/css/site.css">
  <% if (jsonld) { %><script type="application/ld+json"><%- JSON.stringify(jsonld).replace(/</g, '\\u003c') %></script><% } %>
  <% if (S.plausible_domain) { %><script defer data-domain="<%= S.plausible_domain %>" src="https://plausible.io/js/script.js"></script><% } %>
  <% if (S.ga_measurement_id && /^G-[A-Z0-9]+$/.test(S.ga_measurement_id)) { %><script async src="https://www.googletagmanager.com/gtag/js?id=<%= S.ga_measurement_id %>"></script><script src="/public/js/ga.js?id=<%= S.ga_measurement_id %>"></script><% } %>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<% if (S.announcement) { %><div class="announce"><%= S.announcement %></div><% } %>
<header class="site-header">
  <div class="wrap hdr">
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" data-nav-toggle><span></span><span></span><span></span></button>
    <a class="brand" href="/" aria-label="<%= S.business_name %> home">
      <% if (S.logo_path) { %><img src="<%= S.logo_path %>" alt="<%= S.business_name %>" height="40"><% } else { %><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M16 5h8v5h-8zM14 10h12v4H14zM11 14h18a3 3 0 0 1 3 3v15a3 3 0 0 1-3 3H11a3 3 0 0 1-3-3V17a3 3 0 0 1 3-3z"/></svg><span class="brand-text"><%= S.business_name %></span><% } %>
    </a>
    <nav id="main-nav" class="hdr-nav" aria-label="Main">
      <% const cur = currentPath; const on = p => (p === '/' ? cur === '/' : cur === p || cur.indexOf(p + '/') === 0) ? ' aria-current="page"' : ''; %>
      <a href="/"<%- on('/') %>>Home</a>
      <div class="has-sub">
        <a href="/shop"<%- on('/shop') %>>Shop <span class="caret" aria-hidden="true">▾</span></a>
        <div class="sub">
          <a href="/shop">All fragrances</a><a href="/women">Women</a><a href="/men">Men</a><a href="/unisex">Unisex</a><a href="/oils-body-sprays">Oils &amp; body sprays</a><a href="/new-arrivals">New arrivals</a><a href="/best-sellers">Best sellers</a><a href="/offers">Offers &amp; bundles</a>
        </div>
      </div>
      <a href="/about"<%- on('/about') %>>About</a>
      <a href="/blog"<%- on('/blog') %>>Blog</a>
      <a href="/contact"<%- on('/contact') %>>Contact</a>
    </nav>
    <div class="hdr-actions">
      <form class="sbox" action="/search" method="get" role="search" data-search>
        <label class="sr" for="q">Search perfumes</label>
        <input id="q" name="q" type="search" placeholder="Search perfumes, brands, notes…" value="<%= typeof isSearch !== 'undefined' && query.q ? query.q : '' %>" maxlength="80" autocomplete="off">
        <button type="submit" class="icon-btn" aria-label="Search" data-search-btn><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/></svg></button>
      </form>
      <a class="icon-btn" href="/wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.600-7 10-7 10z"/></svg></a>
      <a class="icon-btn" href="<%= customer ? '/account' : '/login' %>" aria-label="<%= customer ? 'My account' : 'Sign in' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.400 3.600-7 8-7s8 2.600 8 7"/></svg></a>
      <a class="icon-btn cart-link" href="/cart" aria-label="Cart<%= cartCount ? ' (' + cartCount + ' items)' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><% if (cartCount) { %><span class="badge"><%= cartCount %></span><% } %></a>
    </div>
  </div>
</header>

<main id="main" class="wrap main">
  <% if (flash) { %><div class="alert alert-<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
  <%- body %>
</main>

<div class="trust-bar"><div class="wrap"><%- include('partials/trust', { cls: 'trust trust-dark' }) %></div></div>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h3><%= S.business_name %></h3>
      <p><%= S.tagline %></p>
      <% if (S.contact_phone) { %><p>Phone: <a href="tel:<%= S.contact_phone.replace(/\s/g,'') %>"><%= S.contact_phone %></a></p><% } %>
      <% if (S.contact_email) { %><p>Email: <a href="mailto:<%= S.contact_email %>"><%= S.contact_email %></a></p><% } %>
      <% if (S.address) { %><p><%= S.address %></p><% } %>
      <% if (S.opening_hours) { %><p><%= S.opening_hours %></p><% } %>
    </div>
    <div>
      <h3>Shop</h3>
      <a href="/shop">All fragrances</a><a href="/men">Men</a><a href="/women">Women</a><a href="/unisex">Unisex</a><a href="/offers">Offers &amp; bundles</a>
    </div>
    <div>
      <h3>Help</h3>
      <a href="/track">Track your order</a><a href="/faq">FAQ</a><a href="/delivery-returns">Delivery &amp; returns</a><a href="/authenticity">Product authenticity</a><a href="/contact">Contact us</a><a href="/about">About us</a>
    </div>
    <div>
      <h3>Legal &amp; social</h3>
      <a href="/privacy">Privacy policy</a><a href="/terms">Terms &amp; conditions</a>
      <% if (S.facebook_url) { %><a href="<%= S.facebook_url %>" rel="noopener" target="_blank">Facebook</a><% } %>
      <% if (S.instagram_url) { %><a href="<%= S.instagram_url %>" rel="noopener" target="_blank">Instagram</a><% } %>
      <% if (S.tiktok_url) { %><a href="<%= S.tiktok_url %>" rel="noopener" target="_blank">TikTok</a><% } %>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> <%= S.business_name %>. Prices in Ghana cedis (<%= S.currency_symbol %>).</span>
  </div>
</footer>
<% const wa = waLink(); if (wa) { %><a class="wa-float" href="<%= wa %>" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">WhatsApp</a><% } %>
<script src="/public/js/site.js" defer></script>
</body>
</html>
