<%
const icons = {
  shield: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>',
  truck: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>',
  card: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h4"/></svg>',
  chat: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/></svg>'
};
const items = [['shield', S.trust_authentic], ['truck', S.trust_delivery], ['card', S.trust_payment], ['chat', S.trust_support]].filter(i => i[1]);
%>
<ul class="<%= cls %>">
  <% items.forEach(i => { %><li><span class="ti"><%- icons[i[0]] %></span><span><%= i[1] %></span></li><% }) %>
</ul>
