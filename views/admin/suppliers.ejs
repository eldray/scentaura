<div class="admin-top"><h1>Suppliers &amp; purchasing</h1><div><a class="btn btn-gold" href="/admin/suppliers/purchases/new">+ New purchase order</a> <a class="btn btn-ghost" href="/admin/suppliers/new">+ Add supplier</a></div></div>
<div class="box"><h2>Suppliers and what you owe them</h2><table class="table"><thead><tr><th>Supplier</th><th class="num">Goods received (value)</th><th class="num">Paid</th><th class="num">Still owed</th><th></th></tr></thead><tbody>
<% balances.forEach(b => { %><tr><td><a href="/admin/suppliers/<%= b.id %>"><%= b.name %></a></td><td class="num"><%= ghs(b.received_value) %></td><td class="num"><%= ghs(b.paid) %></td><td class="num <%= b.owed > 0 ? 'neg' : '' %>"><%= ghs(b.owed) %></td><td><a href="/admin/suppliers/purchases/new?supplier=<%= b.id %>">New order</a></td></tr><% }) %>
<% if (!balances.length) { %><tr><td colspan="5">No suppliers yet. Add your first one.</td></tr><% } %></tbody></table></div>
<div class="box"><h2>Recent purchase orders</h2><table class="table"><thead><tr><th>Reference</th><th>Supplier</th><th>Date</th><th>Status</th><th class="num">Value</th></tr></thead><tbody>
<% recent.forEach(p => { %><tr><td><a href="/admin/suppliers/purchases/<%= p.id %>"><%= p.reference %></a></td><td><%= p.supplier_name %></td><td><%= p.order_date %></td><td><span class="pill <%= p.status === 'received' ? 'pill-ok' : p.status === 'cancelled' ? 'pill-bad' : 'pill-warn' %>"><%= p.status %></span></td><td class="num"><%= ghs(p.value) %></td></tr><% }) %></tbody></table></div>
