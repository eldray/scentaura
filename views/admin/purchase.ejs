<div class="admin-top"><h1>Purchase <%= po.reference %></h1><a href="/admin/suppliers/<%= po.supplier_id %>">← <%= po.supplier_name %></a></div>
<div class="cards"><div class="stat"><div class="l">Status</div><div class="n" style="font-size:1.2rem"><%= po.status %></div></div><div class="stat"><div class="l">Ordered value</div><div class="n"><%= ghs(po.value) %></div></div><div class="stat"><div class="l">Received value</div><div class="n"><%= ghs(po.receivedValue) %></div></div><div class="stat"><div class="l">Paid</div><div class="n"><%= ghs(po.paid) %></div></div></div>
<p class="small">Date <%= po.order_date %><%= po.supplier_invoice ? ' · Supplier invoice ' + po.supplier_invoice : '' %><%= po.notes ? ' · ' + po.notes : '' %></p>
<form method="post" action="/admin/suppliers/purchases/<%= po.id %>/receive" class="box"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<table class="table"><thead><tr><th>Item</th><th class="num">Ordered</th><th class="num">Received</th><th class="num">Cost</th><th class="num">Selling price</th><th class="num">Margin</th><th>Receive now</th><th>Batch</th><th>Expiry</th></tr></thead><tbody>
<% po.items.forEach(i => { const left = i.qty_ordered - i.qty_received; const m = i.price > 0 ? ((i.price - i.unit_cost) / i.price * 100) : 0; %><tr><td><%= i.product_name %> <small><%= i.label %></small></td><td class="num"><%= i.qty_ordered %></td><td class="num"><%= i.qty_received %></td><td class="num"><%= ghs(i.unit_cost) %></td><td class="num"><%= ghs(i.price) %></td><td class="num <%= m < 0 ? 'neg' : '' %>"><%= m.toFixed(0) %>%</td>
<td><% if (left > 0 && !['cancelled','received'].includes(po.status)) { %><input name="recv_<%= i.id %>" type="number" min="0" max="<%= left %>" value="<%= left %>" style="width:80px" aria-label="Receive quantity"><% } else { %>–<% } %></td>
<td><% if (left > 0 && !['cancelled','received'].includes(po.status)) { %><input name="batch_<%= i.id %>" style="width:90px" aria-label="Batch"><% } %></td><td><% if (left > 0 && !['cancelled','received'].includes(po.status)) { %><input name="exp_<%= i.id %>" type="date" aria-label="Expiry"><% } %></td></tr><% }) %></tbody></table>
<% if (!['cancelled','received'].includes(po.status)) { %><button class="btn btn-gold" type="submit">Receive goods into stock</button><% } %></form>
<% if (po.status === 'pending') { %><form method="post" action="/admin/suppliers/purchases/<%= po.id %>/cancel" data-confirm="Cancel this purchase order?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-small" type="submit">Cancel order</button></form><% } %>
<div class="box"><h2>Pay the supplier</h2><p>Still to pay for goods received: <strong><%= ghs(Math.max(0, po.receivedValue - po.paid)) %></strong></p>
<form method="post" action="/admin/suppliers/purchases/<%= po.id %>/pay" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="amount" placeholder="Amount GHS" required inputmode="decimal"><input name="paid_on" type="date" value="<%= new Date().toISOString().slice(0,10) %>"><input name="method" placeholder="Method (MoMo, bank…)"><input name="note" placeholder="Note"><button class="btn btn-small">Record payment</button></form>
<table class="table"><tbody><% po.payments.forEach(p => { %><tr><td><%= p.paid_on %></td><td class="num"><%= ghs(p.amount) %></td><td><%= p.method || '' %></td></tr><% }) %></tbody></table></div>
