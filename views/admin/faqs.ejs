<h1>FAQ</h1><p><a href="/admin/content/pages">← Pages</a></p>
<div class="box"><h2>Add a question</h2><form method="post" action="/admin/content/faqs" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- f.input('question','Question','',{required:true}) %><%- f.textarea('answer','Answer','',{rows:3,required:true}) %><button class="btn btn-gold">Add</button></form></div>
<% faqs.forEach(q => { %><div class="box"><form method="post" action="/admin/content/faqs/<%= q.id %>" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- f.input('question','Question',q.question,{id:'q'+q.id}) %><%- f.textarea('answer','Answer',q.answer,{rows:3,id:'a'+q.id}) %>
<div class="inline-form"><label>Order <input name="sort" type="number" value="<%= q.sort %>" style="width:70px"></label><label><input type="checkbox" name="active" value="1" <%= q.active ? 'checked' : '' %>> Shown</label><button class="btn btn-small">Save</button></div></form>
<form method="post" action="/admin/content/faqs/<%= q.id %>/delete" data-confirm="Delete this question?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link" type="submit">Delete</button></form></div><% }) %>
