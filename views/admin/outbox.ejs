<h1>Email outbox</h1><p><a href="/admin/settings">← Settings</a></p><% if (!smtp) { %><div class="alert alert-info">Email sending is not set up, so these messages were only recorded, not sent. Set the SMTP_ values on the server.</div><% } %>
<div class="box"><table class="table"><thead><tr><th>When</th><th>To</th><th>Subject</th><th>Status</th></tr></thead><tbody><% rows.forEach(r => { %><tr><td><%= r.created_at %></td><td><%= r.recipient %></td><td class="wrap-ok"><%= r.subject %></td><td><%= r.status %><%= r.error ? ' – ' + r.error : '' %></td></tr><% }) %></tbody></table></div>
