<div class="admin-top"><h1>Orders</h1><a class="btn btn-ghost" href="/admin/orders?format=csv&q=<%= encodeURIComponent(q) %>&status=<%= status %>&payment=<%= pay %>&from=<%= from %>&to=<%= to %>">Export CSV</a></div>
<form class="filter-bar" method="get"><div class="field"><label for="q">Search</label><input id="q" name="q" value="<%= q %>" placeholder="Order no, name, phone, email"></div>
<div class="field"><label for="status">Status</label><select id="status" name="status"><option value="">All</option><option value="awaiting_dispatch" <%= status === 'awaiting_dispatch' ? 'selected' : '' %>>Awaiting dispatch</option><option value="attention" <%= status === 'attention' ? 'selected' : '' %>>Needs attention</option><% Object.keys(ORDER_STATUSES).forEach(s => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= ORDER_STATUSES[s] %></option><% }) %></select></div>
<div class="field"><label for="payment">Payment</label><select id="payment" name="payment"><option value="">All</option><% ['unpaid','pending','paid','failed','cancelled','partially_refunded','refunded'].forEach(s => { %><option <%= pay === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
<div class="field"><label for="from">From</label><input id="from" type="date" name="from" value="<%= from %>"></div><div class="field"><label for="to">To</label><input id="to" type="date" name="to" value="<%= to %>"></div><button class="btn btn-small">Filter</button></form>
<div class="box"><table class="table"><thead><tr><th>Order</th><th>Date (UTC)</th><th>Customer</th><th>Delivery</th><th>Payment</th><th>Status</th><th class="num">Total</th></tr></thead><tbody>
<% rows.forEach(o => { %><tr><td><a href="/admin/orders/<%= o.id %>"><strong><%= o.order_no %></strong></a><%= o.needs_attention ? ' ⚠️' : '' %></td><td><%= o.created_at %></td><td><%= o.customer_name %><br><small><%= o.customer_phone %></small></td><td><%= o.zone_name %></td>
<td><span class="pill <%= o.payment_status === 'paid' ? 'pill-ok' : ['failed','cancelled'].includes(o.payment_status) ? 'pill-bad' : 'pill-warn' %>"><%= o.payment_method === 'cod' ? 'COD · ' : '' %><%= o.payment_status %></span></td><td><span class="pill <%= o.status === 'delivered' ? 'pill-ok' : o.status === 'cancelled' ? 'pill-bad' : ['dispatched','packed','processing','confirmed'].includes(o.status) ? 'pill-info' : 'pill-warn' %>"><%= ORDER_STATUSES[o.status] %></span></td><td class="num"><%= ghs(o.total) %></td></tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="7">No orders match.</td></tr><% } %></tbody></table>
<p class="small"><%= total %> order(s). Page <%= page %> of <%= pages %>. <% if (page > 1) { %><a href="?page=<%= page - 1 %>&q=<%= q %>&status=<%= status %>&payment=<%= pay %>">Newer</a><% } %> <% if (page < pages) { %><a href="?page=<%= page + 1 %>&q=<%= q %>&status=<%= status %>&payment=<%= pay %>">Older</a><% } %></p></div>
