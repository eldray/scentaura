<div class="admin-top"><h1>Inventory</h1><div><a class="btn btn-ghost" href="/admin/inventory/movements">Stock history</a> <a class="btn btn-ghost" href="/admin/reports/export/stock">Export CSV</a></div></div>
<div class="cards"><div class="stat"><div class="l">Units in stock</div><div class="n"><%= val.units %></div></div><div class="stat"><div class="l">Stock value at cost</div><div class="n"><%= ghs(val.cost_value) %></div><div class="l">weighted-average cost</div></div><div class="stat"><div class="l">Stock value at selling price</div><div class="n"><%= ghs(val.retail_value) %></div></div></div>
<form class="filter-bar" method="get"><div class="field"><label for="q">Search</label><input id="q" name="q" value="<%= q %>"></div>
<div class="field"><label for="show">Show</label><select id="show" name="show"><option value="all">Everything</option><option value="low" <%= filter === 'low' ? 'selected' : '' %>>Low stock</option><option value="out" <%= filter === 'out' ? 'selected' : '' %>>Out of stock</option></select></div><button class="btn btn-small">Filter</button></form>
<div class="box"><table class="table"><thead><tr><th>Product</th><th>Size</th><th>SKU</th><th class="num">On hand</th><th class="num">Held for orders</th><th class="num">Available</th><th>Alert at</th><th>Adjust (reason required)</th><th>Count</th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td><%= r.product_name %></td><td><%= r.label %></td><td><%= r.sku %></td><td class="num"><%= r.on_hand %></td><td class="num"><%= r.reserved %></td>
<td class="num"><span class="pill <%= r.available <= 0 ? 'pill-bad' : r.available <= r.low_stock_threshold ? 'pill-warn' : 'pill-ok' %>"><%= r.available %></span></td><td><%= r.low_stock_threshold %></td>
<td><form method="post" action="/admin/inventory/adjust" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="variantId" value="<%= r.id %>">
<select name="direction" aria-label="Add or remove"><option value="add">+ Add</option><option value="remove">− Remove</option></select><input name="qty" type="number" min="1" style="width:64px" required aria-label="Quantity">
<select name="kind" aria-label="Type"><option value="adjustment">Correction</option><option value="damage">Damaged/lost</option></select><input name="reason" placeholder="Reason" required style="width:140px"><button class="btn btn-small">Save</button></form></td>
<td><form method="post" action="/admin/inventory/count" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="variantId" value="<%= r.id %>"><input name="counted" type="number" min="0" placeholder="Counted" style="width:80px" required aria-label="Counted on shelf"><button class="btn btn-small btn-ghost">Set</button></form></td></tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="9">Nothing to show.</td></tr><% } %></tbody></table>
<p class="small">To receive new stock from a supplier, use <a href="/admin/suppliers/purchases/new">Suppliers &amp; purchases</a> so the cost is recorded too.</p></div>
