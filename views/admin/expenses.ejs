<div class="admin-top"><h1>Expenses</h1><a class="btn btn-ghost" href="/admin/expenses?format=csv&from=<%= from %>&to=<%= to %>">Export CSV</a></div>
<div class="box"><h2>Record an expense</h2><form method="post" action="/admin/expenses" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="date" name="spent_on" value="<%= today %>" aria-label="Date">
<select name="category" aria-label="Category"><% categories.forEach(c => { %><option><%= c %></option><% }) %></select><input name="description" placeholder="What was it for?" style="min-width:220px"><input name="amount" placeholder="Amount GHS" required inputmode="decimal" style="width:120px"><button class="btn btn-gold btn-small">Save</button></form>
<p class="small">Record delivery payments to riders as “Delivery costs”, and airtime/data/ads as their own categories. Do not record stock purchases here – use Suppliers &amp; purchases.</p></div>
<form class="filter-bar" method="get"><div class="field"><label for="from">From</label><input id="from" type="date" name="from" value="<%= from %>"></div><div class="field"><label for="to">To</label><input id="to" type="date" name="to" value="<%= to %>"></div><button class="btn btn-small">Show</button></form>
<div class="box"><table class="table"><thead><tr><th>Date</th><th>Category</th><th>Description</th><th class="num">Amount</th><th></th></tr></thead><tbody><% rows.forEach(r => { %><tr><td><%= r.spent_on %></td><td><%= r.category %></td><td class="wrap-ok"><%= r.description %></td><td class="num"><%= ghs(r.amount) %></td><td><form method="post" action="/admin/expenses/<%= r.id %>/delete" data-confirm="Delete this expense?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link" type="submit">Delete</button></form></td></tr><% }) %>
<tr><td colspan="3"><strong>Total</strong></td><td class="num"><strong><%= ghs(total) %></strong></td><td></td></tr></tbody></table></div>
