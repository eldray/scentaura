<h1>Deliveries</h1>
<div class="box"><h2>Delivery zones and prices</h2><p class="small">Customers choose one option at checkout. “Free over” makes delivery free when the order (after discount) reaches that amount. Fees below are yours to decide – nothing is pre-filled.</p>
<% zones.forEach(z => { %><div class="panel"><form method="post" action="/admin/deliveries/zones/<%= z.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input name="name" value="<%= z.name %>" aria-label="Zone name"><input name="description" value="<%= z.description || '' %>" placeholder="Areas covered" style="min-width:240px" aria-label="Description"><label><input type="checkbox" name="active" value="1" <%= z.active ? 'checked' : '' %>> Active</label><button class="btn btn-small">Save zone</button></form>
<table class="table"><thead><tr><th>Method</th><th>Name shown</th><th>Fee</th><th>Free over</th><th>Min order</th><th>Estimated time</th><th>Courier</th><th>Active</th><th></th></tr></thead><tbody>
<% z.rates.forEach(r => { const fid = 'rf' + r.id; %><tr><td><form id="<%= fid %>" method="post" action="/admin/deliveries/rates/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
<select form="<%= fid %>" name="method" aria-label="Method"><% Object.keys(METHODS).forEach(m => { %><option value="<%= m %>" <%= r.method === m ? 'selected' : '' %>><%= METHODS[m] %></option><% }) %></select></td>
<td><input form="<%= fid %>" name="name" value="<%= r.name %>" aria-label="Name"></td><td><input form="<%= fid %>" name="fee" value="<%= fromPesewas(r.fee) %>" style="width:80px" inputmode="decimal" aria-label="Fee"></td>
<td><input form="<%= fid %>" name="free_over" value="<%= r.free_over === null ? '' : fromPesewas(r.free_over) %>" style="width:90px" inputmode="decimal" aria-label="Free over"></td><td><input form="<%= fid %>" name="min_order" value="<%= r.min_order ? fromPesewas(r.min_order) : '' %>" style="width:80px" inputmode="decimal" aria-label="Minimum order"></td>
<td><input form="<%= fid %>" name="eta_text" value="<%= r.eta_text %>" style="width:130px" aria-label="Estimated time"></td>
<td><select form="<%= fid %>" name="courier_id" aria-label="Courier"><option value="">—</option><% couriers.forEach(c => { %><option value="<%= c.id %>" <%= r.courier_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></td>
<td><input form="<%= fid %>" type="checkbox" name="active" value="1" <%= r.active ? 'checked' : '' %> aria-label="Active"><input form="<%= fid %>" type="hidden" name="instructions" value="<%= r.instructions || '' %>"></td><td><button form="<%= fid %>" class="btn btn-small">Save</button></td></tr>
<% if (r.method === 'pickup' || r.method === 'collection_point') { %><tr><td colspan="9"><form method="post" action="/admin/deliveries/rates/<%= r.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="method" value="<%= r.method %>"><input type="hidden" name="name" value="<%= r.name %>"><input type="hidden" name="fee" value="<%= fromPesewas(r.fee) %>"><input type="hidden" name="eta_text" value="<%= r.eta_text %>"><input type="hidden" name="active" value="<%= r.active ? 1 : '' %>">
Address shown to customer: <input name="instructions" value="<%= r.instructions || '' %>" style="min-width:380px"><button class="btn btn-small btn-ghost">Save address</button></form></td></tr><% } %>
<% }) %></tbody></table>
<details><summary>Add a delivery option to <%= z.name %></summary><form method="post" action="/admin/deliveries/rates" class="inline-form" style="margin-top:.6rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="zone_id" value="<%= z.id %>">
<select name="method" aria-label="Method"><% Object.keys(METHODS).forEach(m => { %><option value="<%= m %>"><%= METHODS[m] %></option><% }) %></select><input name="name" placeholder="Name shown to customer"><input name="fee" placeholder="Fee GHS" required inputmode="decimal" style="width:90px"><input name="free_over" placeholder="Free over (optional)" inputmode="decimal" style="width:130px"><input name="eta_text" placeholder="e.g. 1–2 working days"><button class="btn btn-small">Add</button></form></details>
<form method="post" action="/admin/deliveries/zones/<%= z.id %>/delete" data-confirm="Delete this zone and its options?" style="margin-top:.5rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link" type="submit">Delete zone</button></form></div><% }) %>
<form method="post" action="/admin/deliveries/zones" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="New zone name" required><input name="description" placeholder="Areas covered"><button class="btn btn-small">Add zone</button></form></div>
<div class="box"><h2>Couriers</h2><p class="small">Add the riders and companies you use. If a courier has a public tracking page, put its address with {tracking} where the number goes (must start with https://).</p>
<table class="table"><tbody><% couriers.forEach(c => { const cf = 'cf' + c.id; %><tr><td><form id="<%= cf %>" method="post" action="/admin/deliveries/couriers/<%= c.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><input form="<%= cf %>" name="name" value="<%= c.name %>" aria-label="Name"></td><td><input form="<%= cf %>" name="phone" value="<%= c.phone || '' %>" aria-label="Phone"></td><td><input form="<%= cf %>" name="tracking_url" value="<%= c.tracking_url || '' %>" placeholder="https://…/{tracking}" style="min-width:260px" aria-label="Tracking URL"></td><td><input form="<%= cf %>" type="checkbox" name="active" value="1" <%= c.active ? 'checked' : '' %> aria-label="Active"></td><td><button form="<%= cf %>" class="btn btn-small">Save</button></td></tr><% }) %></tbody></table>
<form method="post" action="/admin/deliveries/couriers" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Courier name" required><input name="phone" placeholder="Phone"><input name="tracking_url" placeholder="Tracking link (optional)"><button class="btn btn-small">Add courier</button></form></div>
<div class="box"><h2>Orders to deliver</h2><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Zone</th><th>Status</th><th>Courier</th><th>Tracking</th><th>Failed attempts</th></tr></thead><tbody>
<% inTransit.forEach(o => { %><tr><td><a href="/admin/orders/<%= o.id %>"><%= o.order_no %></a></td><td><%= o.customer_name %> <small><%= o.customer_phone %></small></td><td><%= o.zone_name %></td><td><%= ORDER_STATUSES[o.status] %></td><td><%= o.courier_name || '–' %></td><td><%= o.tracking_no || '' %></td><td><%= o.attempts %></td></tr><% }) %>
<% if (!inTransit.length) { %><tr><td colspan="7">Nothing waiting.</td></tr><% } %></tbody></table></div>
