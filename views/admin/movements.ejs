<div class="admin-top"><h1>Stock history</h1><a class="btn btn-ghost" href="/admin/inventory/movements?format=csv<%= variantId ? '&variant=' + variantId : '' %><%= type ? '&type=' + type : '' %>">Export CSV</a></div>
<form class="filter-bar" method="get"><div class="field"><label for="type">Type</label><select id="type" name="type"><option value="">All</option><% ['opening','purchase','sale','return','damage','adjustment','count','reserve','release','cancel_restore'].forEach(t => { %><option <%= type === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div><% if (variantId) { %><input type="hidden" name="variant" value="<%= variantId %>"><% } %><button class="btn btn-small">Filter</button></form>
<div class="box"><table class="table"><thead><tr><th>When (UTC)</th><th>Product</th><th>Type</th><th class="num">On hand</th><th class="num">Held</th><th class="num">After</th><th>Reference</th><th>Reason</th><th>By</th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td><%= r.created_at %></td><td><%= r.product_name %> <small><%= r.label %></small></td><td><%= r.type %></td><td class="num <%= r.on_hand_change < 0 ? 'neg' : '' %>"><%= r.on_hand_change > 0 ? '+' : '' %><%= r.on_hand_change || '' %></td><td class="num"><%= r.reserved_change > 0 ? '+' : '' %><%= r.reserved_change || '' %></td><td class="num"><%= r.on_hand_after %>/<%= r.reserved_after %></td><td><%= r.reference || '' %></td><td class="wrap-ok"><%= r.reason || '' %></td><td><%= r.user_name || '' %></td></tr><% }) %></tbody></table>
<p class="small">Showing page <%= page %> of <%= pages %> (<%= total %> records). <% if (page > 1) { %><a href="?page=<%= page - 1 %>&type=<%= type %>">Newer</a><% } %> <% if (page < pages) { %><a href="?page=<%= page + 1 %>&type=<%= type %>">Older</a><% } %></p></div>
