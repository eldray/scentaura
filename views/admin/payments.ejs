<div class="admin-top"><h1>Payments &amp; reconciliation</h1><a class="btn btn-ghost" href="/admin/payments?format=csv&from=<%= rec.from %>&to=<%= rec.to %>">Export CSV</a></div>
<form class="filter-bar" method="get"><div class="field"><label for="from">From</label><input id="from" type="date" name="from" value="<%= rec.from %>"></div><div class="field"><label for="to">To</label><input id="to" type="date" name="to" value="<%= rec.to %>"></div><button class="btn btn-small">Show</button></form>
<div class="cards"><div class="stat"><div class="l">Confirmed payments</div><div class="n"><%= ghs(rec.totals.success) %></div></div><div class="stat"><div class="l">Still pending</div><div class="n"><%= ghs(rec.totals.pending) %></div></div><div class="stat"><div class="l">Paystack fees (recorded)</div><div class="n"><%= ghs(rec.totals.fees) %></div></div><div class="stat"><div class="l">Refunded</div><div class="n"><%= ghs(rec.totals.refunded) %></div></div>
<div class="stat"><div class="l">Problems found</div><div class="n <%= rec.totals.issues ? 'neg' : 'pos' %>"><%= rec.totals.issues %></div></div></div>
<% if (rec.orphan.length) { %><div class="alert alert-error">Orders marked paid without a payment record: <%= rec.orphan.map(o => o.order_no).join(', ') %></div><% } %>
<div class="box"><table class="table"><thead><tr><th>Created (UTC)</th><th>Order</th><th>Reference</th><th>Channel</th><th class="num">Amount</th><th class="num">Fee</th><th>Status</th><th>Order payment</th><th>Problems</th></tr></thead><tbody>
<% rec.rows.forEach(x => { %><tr><td><%= x.created_at %></td><td><%= x.order_no %></td><td><%= x.reference %></td><td><%= x.channel || x.provider %></td><td class="num"><%= ghs(x.amount) %></td><td class="num"><%= x.fee ? ghs(x.fee) : '' %></td><td><%= x.status %></td><td><%= x.order_payment_status %></td><td class="wrap-ok neg"><%= x.issues.join('; ') %></td></tr><% }) %>
<% if (!rec.rows.length) { %><tr><td colspan="9">No payments in this period.</td></tr><% } %></tbody></table>
<p class="small">Compare the “Confirmed payments” total with your Paystack dashboard (Transactions) for the same dates. Paystack pays you out later, minus its fees, so your bank deposits will differ.</p></div>
