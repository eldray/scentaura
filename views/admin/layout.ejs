<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle ? pageTitle + ' | ' : '' %>Admin – <%= S.business_name %></title><meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/public/img/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/public/css/site.css"></head>
<body class="admin-body">
<% if (typeof bare !== 'undefined' && bare) { %>
  <% if (flash) { %><div class="alert alert-<%= flash.type %>" style="max-width:420px;margin:1rem auto"><%= flash.msg %></div><% } %>
  <%- body %>
<% } else { %>
<div class="admin-shell">
  <aside class="admin-side" id="admin-side">
    <a class="brand-text" href="/admin"><%= S.business_name %></a>
    <% const items = [['dashboard','/admin','Dashboard'],['orders','/admin/orders','Orders'],['deliveries','/admin/deliveries','Deliveries'],['products','/admin/products','Products'],['inventory','/admin/inventory','Inventory'],['suppliers','/admin/suppliers','Suppliers & purchases'],['customers','/admin/customers','Customers'],['promotions','/admin/promotions','Promotions'],['payments','/admin/payments','Payments'],['expenses','/admin/expenses','Expenses'],['reports','/admin/reports','Reports & profit'],['content','/admin/content/pages','Pages, blog & reviews'],['settings','/admin/settings','Settings'],['users','/admin/users','Staff & permissions']]; %>
    <% items.forEach(i => { if (can(i[0])) { const here = i[1] === '/admin' ? currentPath === '/' || currentPath === '' : ('/admin' + currentPath).startsWith(i[1].replace('/pages','')); %><a href="<%= i[1] %>"<%- here ? ' aria-current="page"' : '' %>><%= i[2] %></a><% } }) %>
    <hr>
    <a href="/" target="_blank" rel="noopener">View shop ↗</a>
    <a href="/admin/help">Help</a>
    <a href="/admin/account">My account</a>
    <div class="who"><%= staff.name %><br><%= ROLE_LABELS[staff.role] %></div>
    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-small" type="submit" style="margin:.4rem .7rem">Sign out</button></form>
  </aside>
  <div class="admin-main">
    <button class="btn btn-ghost btn-small admin-menu-btn" type="button" data-admin-menu>☰ Menu</button>
    <% if (flash) { %><div class="alert alert-<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
    <%- body %>
  </div>
</div>
<% } %>
<script src="/public/js/site.js" defer></script>
</body></html>
