<h1>Staff &amp; permissions</h1>
<div class="box"><h2>Roles</h2><ul><li><strong>Owner</strong> – everything, including settings and staff.</li><li><strong>Store manager</strong> – everything except settings and staff.</li><li><strong>Sales / order processing</strong> – orders, customers, deliveries.</li><li><strong>Inventory staff</strong> – products, stock and suppliers.</li></ul></div>
<div class="box"><h2>Add a staff member</h2><form method="post" action="/admin/users" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><%- f.input('name','Name','',{required:true}) %><%- f.input('email','Email','',{required:true,type:'email'}) %>
<%- f.select('role','Role',ROLES.map(r => ({value:r,label:{owner:'Owner',manager:'Store manager',sales:'Sales / order processing',inventory:'Inventory staff'}[r]})),'sales') %><%- f.input('password','Temporary password (10+ characters)','',{required:true,type:'password',autocomplete:'new-password'}) %><button class="btn btn-gold">Create account</button></form></div>
<div class="box"><h2>Team</h2><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>New password</th><th>Last sign-in</th><th></th></tr></thead><tbody>
<% users.forEach(u => { const fid = 'uf' + u.id; %><tr><td><form id="<%= fid %>" method="post" action="/admin/users/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><input form="<%= fid %>" name="name" value="<%= u.name %>" aria-label="Name"></td><td><%= u.email %></td>
<td><select form="<%= fid %>" name="role" aria-label="Role"><% ROLES.forEach(r => { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option><% }) %></select></td><td><input form="<%= fid %>" type="checkbox" name="active" value="1" <%= u.active ? 'checked' : '' %> aria-label="Active"></td>
<td><input form="<%= fid %>" type="password" name="password" placeholder="leave empty" autocomplete="new-password" aria-label="New password"></td><td><%= u.last_login || 'never' %></td><td><button form="<%= fid %>" class="btn btn-small">Save</button></td></tr><% }) %></tbody></table></div>
