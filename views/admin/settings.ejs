<h1>Settings</h1><p><a href="/admin/settings/audit">Activity log</a> · <a href="/admin/settings/outbox">Email outbox</a></p>
<div class="box"><h2>System status</h2><ul>
<li><%= system.momo ? '✅' : '⬜' %> MTN Mobile Money <%= system.momo ? (system.momoEnv === 'sandbox' ? 'is connected in SANDBOX mode (no real money)' : 'is connected in LIVE mode') : 'is not connected. Fill in the MOMO_* values on the server.' %></li>
<li><%= system.paystack ? '✅' : '⬜' %> Paystack <%= system.paystack ? (system.paystackTest ? 'is connected in TEST mode (no real money)' : 'is connected in LIVE mode') : 'is not connected. Set PAYSTACK_SECRET_KEY on the server.' %></li>
<li><%= system.smtp ? '✅' : '⬜' %> Email sending <%= system.smtp ? 'is set up' : 'is not set up (emails are only listed in the outbox). Set the SMTP_ values on the server.' %></li>
<li><%= /^https:/.test(system.baseUrl) ? '✅' : '⬜' %> Shop address: <%= system.baseUrl %><%= /^https:/.test(system.baseUrl) ? '' : ' (should start with https:// when live)' %></li></ul>
<p class="small">MTN MoMo needs no webhook setup: the shop sends its own callback address with each request and always double-checks with MTN.</p>
<p class="small">Webhook address to enter in Paystack (Settings → API Keys &amp; Webhooks): <code><%= system.baseUrl %>/webhooks/paystack</code></p></div>
<form method="post" action="/admin/settings" class="box"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Business details</h2>
<div class="grid-2"><div><%- f.input('business_name','Business name',S.business_name,{required:true}) %><%- f.input('tagline','Tagline',S.tagline) %><%- f.input('contact_email','Contact email',S.contact_email,{type:'email'}) %><%- f.input('contact_phone','Contact phone',S.contact_phone) %>
<%- f.input('whatsapp_number','WhatsApp number',S.whatsapp_number,{help:'e.g. 0241234567 or 233241234567 – enables the WhatsApp buttons.'}) %><%- f.textarea('address','Address',S.address,{rows:2}) %><%- f.input('opening_hours','Opening hours',S.opening_hours) %>
<%- f.input('map_embed_url','Google Maps embed link',S.map_embed_url,{help:'In Google Maps: Share → Embed a map → copy only the address inside src="…". Must start with https://www.google.com/maps/embed?'}) %></div>
<div><%- f.input('currency_symbol','Currency label',S.currency_symbol) %><%- f.input('announcement','Top banner message (optional)',S.announcement) %><%- f.input('hero_title','Home page headline',S.hero_title) %><%- f.input('hero_subtitle','Home page sub-headline',S.hero_subtitle) %>
<%- f.input('facebook_url','Facebook page link',S.facebook_url,{type:'url'}) %><%- f.input('instagram_url','Instagram link',S.instagram_url,{type:'url'}) %><%- f.input('tiktok_url','TikTok link',S.tiktok_url,{type:'url'}) %></div></div>
<h2>Trust badges (home page)</h2><p class="small">Only say things that are true. Delete a line to hide it.</p><div class="grid-2"><%- f.input('trust_authentic','Badge 1',S.trust_authentic) %><%- f.input('trust_delivery','Badge 2',S.trust_delivery) %><%- f.input('trust_payment','Badge 3',S.trust_payment) %><%- f.input('trust_support','Badge 4',S.trust_support) %></div>
<h2>Orders &amp; payments</h2><div class="grid-2"><div><%- f.input('order_notify_email','Send new-order alerts to',S.order_notify_email,{type:'email',help:'Leave empty to use the contact email.'}) %>
<%- f.check('cod_enabled','Allow pay on delivery / pickup',S.cod_enabled === '1',{help:'Orders stay unpaid until you press “Record cash collected”. Stock is reserved when ordered and leaves when you dispatch.'}) %><%- f.input('cod_label','Pay-on-delivery label',S.cod_label) %></div>
<div><%- f.input('reservation_minutes','Hold stock for unpaid online orders (minutes)',S.reservation_minutes,{type:'number',min:15,max:1440}) %><%- f.input('referral_discount_percent','Referral discount for a friend’s first order (%)',S.referral_discount_percent,{type:'number',min:0,max:50}) %></div></div>
<h2>Search &amp; analytics</h2><div class="grid-2"><%- f.input('default_meta_description','Default search-engine description',S.default_meta_description,{maxlength:170}) %><%- f.input('plausible_domain','Plausible Analytics domain (optional, privacy-friendly)',S.plausible_domain,{placeholder:'your-domain.com'}) %><%- f.input('ga_measurement_id','Google Analytics ID (optional)',S.ga_measurement_id,{placeholder:'G-XXXXXXXXXX'}) %></div>
<button class="btn btn-gold" type="submit">Save settings</button></form>
<div class="box"><h2>Logo and home-page image</h2><div class="grid-2">
<div><p>Logo: <%= S.logo_path ? '' : 'none (the business name is shown as text)' %></p><% if (S.logo_path) { %><img src="<%= S.logo_path %>" alt="Logo" style="max-height:60px"><form method="post" action="/admin/settings/image/logo/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link">Remove</button></form><% } %>
<form method="post" action="/admin/settings/image/logo?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="inline-form"><input type="file" name="image" accept="image/jpeg,image/png,image/webp" required><button class="btn btn-small">Upload logo</button></form></div>
<div><p>Home banner image: <%= S.hero_image ? '' : 'none' %></p><% if (S.hero_image) { %><img src="<%= S.hero_image %>" alt="Banner" style="max-height:90px"><form method="post" action="/admin/settings/image/hero/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link">Remove</button></form><% } %>
<form method="post" action="/admin/settings/image/hero?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="inline-form"><input type="file" name="image" accept="image/jpeg,image/png,image/webp" required><button class="btn btn-small">Upload image</button></form></div></div>
<p class="small">Only upload images you own or have a licence to use.</p>
<h3 style="margin-top:1.2rem">Home page category pictures</h3>
<p class="small">These are sample pictures. Upload your own to replace them (portrait photos about 4:5 work best). Remove a picture to go back to the sample.</p>
<div class="cat-admin">
<% [['cat-women','cat_img_women','Women'],['cat-men','cat_img_men','Men'],['cat-unisex','cat_img_unisex','Unisex'],['cat-new','cat_img_new','New arrivals'],['cat-best','cat_img_best','Best sellers']].forEach(c => { %>
<div class="cat-up"><strong><%= c[2] %></strong>
<% if (S[c[1]]) { %><img src="<%= S[c[1]] %>" alt="<%= c[2] %> picture"><form method="post" action="/admin/settings/image/<%= c[0] %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link">Use sample picture</button></form><% } else { %><div class="cat-sample">Sample picture</div><% } %>
<form method="post" action="/admin/settings/image/<%= c[0] %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="inline-form"><input type="file" name="image" accept="image/jpeg,image/png,image/webp" required><button class="btn btn-small">Upload</button></form></div>
<% }) %></div></div>
