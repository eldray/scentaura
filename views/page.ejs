<section class="page-hero"><p class="eyebrow"><%= typeof showContact !== 'undefined' ? 'We are here to help' : S.business_name %></p><h1><%= p.title %></h1></section>
<article class="page-card prose">
  <% paragraphs(p.body).forEach(t => { const lines = t.split('\n'); %>
    <% if (lines.length > 1 && lines[0].length < 60 && !/[.:]$/.test(lines[0])) { %><h2 class="h3"><%= lines[0] %></h2><p><%= lines.slice(1).join(' ') %></p><% } else { %><p><%= t %></p><% } %>
  <% }) %>
  <% if (typeof zones !== 'undefined' && zones.length) { %>
  <h2 class="h3">Delivery options and charges</h2>
  <table class="table"><thead><tr><th>Area</th><th>Option</th><th>Fee</th><th>Estimated time</th></tr></thead><tbody>
    <% zones.forEach(z => { %><tr><td><%= z.name %></td><td><%= z.rate %></td><td><%= z.fee ? ghs(z.fee) : 'Free' %><% if (z.free_over !== null) { %><br><small>Free over <%= ghs(z.free_over) %></small><% } %></td><td><%= z.eta_text %></td></tr><% }) %>
  </tbody></table>
  <% } %>
  <% if (typeof showContact !== 'undefined') { %>
  <div class="contact-cards">
    <% if (S.contact_phone) { %><a class="ccard" href="tel:<%= S.contact_phone.replace(/\s/g,'') %>"><span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span><strong>Phone</strong><span><%= S.contact_phone %></span></a><% } %>
    <% if (S.contact_email) { %><a class="ccard" href="mailto:<%= S.contact_email %>"><span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><strong>Email</strong><span><%= S.contact_email %></span></a><% } %>
    <% if (S.address) { %><div class="ccard"><span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.500"/></svg></span><strong>Visit us</strong><span><%= S.address %></span></div><% } %>
    <% if (S.opening_hours) { %><div class="ccard"><span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><strong>Opening hours</strong><span><%= S.opening_hours %></span></div><% } %>
  </div>
  <% if (waLink()) { %><p><a class="btn btn-gold" href="<%= waLink() %>" target="_blank" rel="noopener">Chat with us on WhatsApp</a></p><% } %>
  <% if (S.map_embed_url) { %><iframe class="map" src="<%= S.map_embed_url %>" title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><% } %>
  <% } %>
</article>
